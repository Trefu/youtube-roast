{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "youtube-roast",
  "main": "worker/index.ts",
  "compatibility_date": "2026-01-01",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "vars": {
    "ENABLE_LIVE": "true",
    "ENABLE_AI": "false",
    "AI_MODEL": "@cf/meta/llama-3.1-8b-instruct",
    "DAILY_LIVE_LIMIT": "20"
  },
  "env": {
    "production": {
      "name": "youtube-roast",
      "vars": {
        "ENABLE_LIVE": "false",
        "ENABLE_AI": "false",
        "AI_MODEL": "@cf/meta/llama-3.1-8b-instruct",
        "DAILY_LIVE_LIMIT": "20"
      }
    }
  }
}
